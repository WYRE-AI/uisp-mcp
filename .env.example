# UISP account token (generated in the UISP console under Settings > Users >
# API tokens - can be issued in read-only or read/write mode). Also the base
# URL of the UISP instance this connector talks to - UISP has no shared
# multi-tenant endpoint, every deployment (including Ubiquiti's own
# hosted-cloud tier) runs at its own instance FQDN.
UISP_API_KEY=
UISP_BASE_URL=
